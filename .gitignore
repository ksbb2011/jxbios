# ============================================================================
#  robot_order_picker_imouse —— git 忽略清单（2026-09-13 建立）
#
#  目的：仓库只放**源码与必需资产**；打包产物与运行数据都排除掉，否则仓库
#        会轻松涨到 1GB+（dist 单是 300MB+，backups 里还有历史整包快照）。
# ============================================================================

# ---- 打包产物（PyInstaller；由 installer\build_exe.bat 随时重建）----------
dist/
build/
*.spec.bak

# ---- 历史整包备份（backup_project.py 的产物）------------------------------
backups/

# ---- 运行产物：日志 / 截图 / 轨迹 / 负样本帧 ------------------------------
#  注意：data/templates/ 与 config/ 是**必需资产**，不能排除。
data/logs/
data/shots/
data/traces/
data/neg_frames/

# ---- 标定工具产生的配置备份（每次都重建）---------------------------------
config/*.json.bak*
config/*.json.tmp
data/*.json.bak*
data/*.json.tmp

# ---- 临时文件（自测/排查时用 _ 前缀，正常流程会自动清理）------------------
data/_*

# ---- Python 缓存 / 虚拟环境 ------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ---- 编辑器与本机项目数据 --------------------------------------------------
#  .codebuddy 是本机的项目数据（规则/团队/自动化），**不要删**，但也不必进仓库。
.codebuddy/
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
